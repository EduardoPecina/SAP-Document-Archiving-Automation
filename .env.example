# Copy this file to `.env` and fill in your own values.
# Never commit the real `.env` file to version control.

DRY_RUN=true

SAP_COMPANY_CODE=XXXX
TARGET_YEAR=2026
TARGET_MONTH=01
USER_FILTER=

# Keep the literal "{year}" and "{company}" tokens below -- the script
# substitutes them at startup, so the same .env works across years
# without editing this path every January.
DOCUMENT_ARCHIVE_ROOT=\\your-file-server\shared\accounting\document_archive\{year}\{company}\SA
SOURCE_EXPORT_FOLDER=C:\temp\sap_document_lists

# Node ID of the SAP "Favorites" tree entry that opens the document
# display screen (right-click it in SAP GUI > Favorites and check its
# tree position, or ask your SAP admin).
SAP_DOCUMENT_FAVORITE_NODE=F00002
