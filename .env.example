# Copy this file to `.env` and fill in your own values.
# Never commit the real `.env` file to version control.

DRY_RUN=true

SAP_COMPANY_CODE=XXXX
TARGET_YEAR=2026
TARGET_MONTH=01
USER_FILTER=

DOCUMENT_ARCHIVE_ROOT=\\your-file-server\shared\accounting\document_archive\{year}\{company}\SA
SOURCE_EXPORT_FOLDER=C:\temp\sap_document_lists

SAP_LIST_FAVORITE_NODE=F00001
SAP_DOCUMENT_FAVORITE_NODE=F00002
